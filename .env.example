# Copy to .env.local for development, and set the same values in Vercel.
# .env.local is git-ignored. NEVER commit real keys.

# Supabase — project settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Service role key: server-side only. Used by /api/lead.
# If this ever appears in browser code, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# Phase 4 — Gemini Live voice agent ("Ask SCA"). Server-side only:
# the browser gets a short-lived ephemeral token from a route, never this key.
# GEMINI_API_KEY="YOUR-GEMINI-KEY"

# Signs the short-lived gated-download links (any long random string)
DOWNLOAD_SECRET="change-me-to-a-long-random-string"

# The public home of the site: decides canonicals, sitemap and schema.
# No trailing slash. Set this in Netlify for production.
NEXT_PUBLIC_SITE_URL="https://www.sca-za.com"

# Email notifications (Resend) — the fallback that stops an enquiry being lost
# when the database is unreachable. Enquiries are emailed either way.
# Keys belong to SCA's own Resend account.
RESEND_API_KEY="paste-the-key-from-resend"
# Where enquiries and testimonials are sent — Neil, or the office mailbox.
NOTIFY_TO_EMAIL="neil@example.co.za"
# Must be on a domain verified in Resend. Use a sending subdomain so the
# existing GoDaddy MX records are never touched.
# Cloudflare Turnstile (SCA's own Cloudflare account). Forms skip the check until both are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

NOTIFY_FROM_EMAIL="South Coast Advisory <website@send.sca-za.com>"
